{
  "name": "everdawn-online",
  "version": "5.0.0",
  "private": true,
  "description": "Everdawn authoritative cooperative RPG server and browser client",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/main.cjs",
    "check:game": "node rpg-check.cjs",
    "check:online": "node server/check.cjs",
    "build": "node build-cloudflare.cjs",
    "build:offline": "python3 build-rpg.py",
    "deploy": "wrangler deploy",
    "dev:cloudflare": "wrangler dev --local --port 8787",
    "check:cloudflare": "node cloudflare/check.cjs",
    "check:net": "node server/netcheck.cjs",
    "check:growth": "node rpg-growth-check.cjs"
  },
  "devDependencies": {
    "wrangler": "^4.162.0",
    "ws": "^8.23.0"
  }
}
